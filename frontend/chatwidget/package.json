{
  "name": "chatwidget-components-lit",
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Lit Web Component implementation of Zotly Chat Widget using Atomic Design Structure",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:update": "playwright test --project=chromium --update-snapshots",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/web-components-vite": "^10.5.7",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "chromatic": "^18.1.0",
    "happy-dom": "^20.11.2",
    "storybook": "^10.5.7",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^4.1.10"
  }
}
