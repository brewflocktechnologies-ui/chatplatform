meta {
  name: 04 Get Allocation
  type: grpc
  seq: 4
}

grpc {
  url: {{allocGrpcUrl}}
  method: /allocation.v1.AllocationService/GetAllocation
  body: grpc
  auth: none
  methodType: unary
}

metadata {
  x-tenant-id: {{dev_tenant_id}}
  authorization: Bearer {{access_token}}
}

body:grpc {
  name: message 1
  content: '''
  {
    "allocationId": "{{allocation_id}}"
  }
  '''
}

docs {
  Fetches the allocation created in request 02. A random UUID returns
  NOT_FOUND; a non-UUID string returns INVALID_ARGUMENT (protovalidate).
  Tenancy is enforced server-side: another tenant's id also returns
  NOT_FOUND, never someone else's data.
}
