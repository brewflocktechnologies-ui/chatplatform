meta {
  name: 07 Wrong Client Secret (expect 401)
  type: http
  seq: 7
}

post {
  url: {{authUrl}}/oauth2/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: dev-cli
  password: wrong-secret
}

body:form-urlencoded {
  grant_type: client_credentials
}

assert {
  res.status: eq 401
}

docs {
  Negative case: bad client credentials are rejected by the token endpoint.
}
