meta {
  name: 02 chatservice health
  type: http
  seq: 2
}

get {
  url: http://127.0.0.1:8081/actuator/health
}

assert {
  res.status: eq 200
  res.body.status: eq UP
}

docs {
  Actuator health for chatservice. Management ports are published loopback-only
  on the host (127.0.0.1:8081) - deliberately not part of the public
  surface, no token required.
}
