meta {
  name: 03 accountservice health
  type: http
  seq: 3
}

get {
  url: http://127.0.0.1:8091/actuator/health
}

assert {
  res.status: eq 200
  res.body.status: eq UP
}

docs {
  Actuator health for accountservice. Management ports are published loopback-only
  on the host (127.0.0.1:8091) - deliberately not part of the public
  surface, no token required.
}
