meta {
  name: 01 authservice health
  type: http
  seq: 1
}

get {
  url: http://127.0.0.1:8111/actuator/health
}

assert {
  res.status: eq 200
  res.body.status: eq UP
}

docs {
  Actuator health for authservice. Management ports are published loopback-only
  on the host (127.0.0.1:8111) - deliberately not part of the public
  surface, no token required.
}
